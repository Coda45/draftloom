{
    "name": "draftloom",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "server:dev": "tsx watch server/index.ts",
        "build": "tsc --noEmit && vite build",
        "start": "tsx server/index.ts",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "express": "5.3.0",
        "multer": "2.5.0",
        "qrcode": "1.5.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "three": "0.187.0"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/multer": "2.3.0",
        "@types/node": "22.20.5",
        "@types/qrcode": "1.5.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.187.0",
        "@vitejs/plugin-react": "6.3.0",
        "fake-indexeddb": "6.2.8",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vite": "8.3.8",
        "vitest": "5.1.0"
    }
}
